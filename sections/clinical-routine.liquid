<section class="py-16 bg-gradient-to-b from-surface to-slate-100/70 border-b border-slate-200/60" id="RoutineBuilderSection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="badge-clinical bg-emerald-100 text-emerald-800 mb-2">Physician Curated System</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">The 3-Step Barrier Restoration Protocol</h2>
      <p class="text-base text-slate-600 mt-2">Dermatologists agree: layering compatible therapeutic actives yields 3x faster cellular healing than standalone treatments.</p>
    </div>

    <!-- Routine Grid Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      
      <!-- Step 1 -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm relative flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <span class="w-8 h-8 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center">01</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Step 1: Cleanse</span>
        </div>
        <div class="aspect-square rounded-2xl bg-slate-50 overflow-hidden mb-4 relative">
          <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=500&q=80" alt="Amino Gel Cleanser" class="w-full h-full object-cover">
        </div>
        <h3 class="font-bold text-slate-900 text-base">Gentle Amino Micellar Wash</h3>
        <p class="text-xs text-slate-500 mt-1">Non-stripping pH 5.5 physiological foam.</p>
        <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-100">
          <span class="font-bold text-slate-900 text-sm">$32.00</span>
          <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Included in Routine</span>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-3xl p-6 border-2 border-primary/20 shadow-md relative flex flex-col">
        <div class="absolute -top-3 right-6 bg-primary text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow">
          Core Treatment
        </div>
        <div class="flex items-center justify-between mb-4">
          <span class="w-8 h-8 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center">02</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Step 2: Repair</span>
        </div>
        <div class="aspect-square rounded-2xl bg-slate-50 overflow-hidden mb-4 relative">
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80" alt="CeraRepair Barrier Emulsion" class="w-full h-full object-cover">
        </div>
        <h3 class="font-bold text-slate-900 text-base">CeraRepair™ Cellular Lipid Emulsion</h3>
        <p class="text-xs text-slate-500 mt-1">Bio-fermented ceramides 3:1:1 + squalane.</p>
        <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-100">
          <span class="font-bold text-slate-900 text-sm">$58.00</span>
          <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Included in Routine</span>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm relative flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <span class="w-8 h-8 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center">03</span>
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Step 3: Shield</span>
        </div>
        <div class="aspect-square rounded-2xl bg-slate-50 overflow-hidden mb-4 relative">
          <img src="https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=500&q=80" alt="Physical Shield SPF 50" class="w-full h-full object-cover">
        </div>
        <h3 class="font-bold text-slate-900 text-base">Invisible Mineral SPF 50+ Shield</h3>
        <p class="text-xs text-slate-500 mt-1">Non-nano zinc oxide with blue-light defense.</p>
        <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-100">
          <span class="font-bold text-slate-900 text-sm">$38.00</span>
          <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Included in Routine</span>
        </div>
      </div>

    </div>

    <!-- Bundle Bar Summary Card -->
    <div class="bg-primary text-white rounded-3xl p-8 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="badge-clinical bg-emerald-400 text-slate-950 font-extrabold text-xs">Bundle & Save 15%</span>
          <span class="text-xs text-slate-300">Complete 3-Piece Medical Regimen</span>
        </div>
        <h3 class="text-2xl font-black">Complete Daily Cellular Recovery Kit</h3>
        <p class="text-xs text-slate-300 mt-1">Clinically proven to repair trans-epidermal water loss (TEWL) by 98% in 7 days.</p>
      </div>

      <div class="flex items-center gap-6 flex-shrink-0">
        <div class="text-right">
          <span class="text-xs text-slate-400 line-through block font-semibold">$128.00</span>
          <span class="text-3xl font-black text-white">$108.80</span>
          <span class="text-[11px] text-emerald-300 block font-bold">You Save $19.20</span>
        </div>

        <button
          type="button"
          id="AddBundleBtn"
          onclick="ShopifyCart.addItem('bundle_3step', 1, { title: 'Complete 3-Piece Barrier Recovery Kit', price: 108.80, image: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=500&q=80' })"
          class="bg-emerald-400 text-slate-950 hover:bg-emerald-300 font-extrabold px-8 py-4 rounded-full shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
        >
          <span class="material-symbols-outlined">add_shopping_cart</span>
          <span>Add Complete Regimen</span>
        </button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Clinical Routine",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Routine"
    }
  ]
}
{% endschema %}
