<section class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50 to-surface py-16 lg:py-24 border-b border-slate-100">
  <!-- Subtle clinical grid background -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#002d59_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text & Value Prop (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-6 shadow-sm">
          <span class="material-symbols-outlined text-sm text-emerald-600">verified</span>
          <span>{{ section.settings.badge | default: "Dermatologist-Formulated Medical Skincare" }}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-6">
          {{ section.settings.heading | default: "Pure Clinical Actives. Proven Molecular Barrier Repair." }}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mb-8">
          {{ section.settings.subheading | default: "Precision dermatology formulations engineered with medical-grade biomimetic ceramides, bio-fermented niacinamide, and micro-molecular hydration. 0% filler, 100% biological absorption." }}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a href="{{ section.settings.primary_cta_url | default: '/collections/all' }}" class="btn-primary w-full sm:w-auto text-base py-3.5 px-8 shadow-lg shadow-primary/20">
            <span>{{ section.settings.primary_cta_text | default: "Shop Formulations" }}</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </a>

          <a href="{{ section.settings.secondary_cta_url | default: '/pages/routine-builder' }}" class="btn-secondary w-full sm:w-auto text-base py-3.5 px-7">
            <span class="material-symbols-outlined text-emerald-700">auto_awesome</span>
            <span>{{ section.settings.secondary_cta_text | default: "Build 3-Step Routine" }}</span>
          </a>
        </div>

        <!-- Clinical Proof Metrics Strip -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-200/80 w-full max-w-lg">
          <div>
            <span class="text-2xl lg:text-3xl font-black text-slate-900 block">98%</span>
            <span class="text-xs text-slate-500 font-medium">Barrier Recovery in 7 Days</span>
          </div>
          <div>
            <span class="text-2xl lg:text-3xl font-black text-slate-900 block">0%</span>
            <span class="text-xs text-slate-500 font-medium">Parabens & Fragrances</span>
          </div>
          <div>
            <span class="text-2xl lg:text-3xl font-black text-emerald-700 block">4.9★</span>
            <span class="text-xs text-slate-500 font-medium">2,400+ Patient Trials</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual / Clinical Bottle Stage (5 cols) -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-md aspect-[4/5] rounded-3xl overflow-hidden bg-gradient-to-tr from-slate-100 to-white shadow-2xl border border-slate-200/80 group">
          <img
            src="{{ section.settings.hero_image | default: 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=800&q=85' }}"
            alt="DermaPure Clinical Skincare Bottle"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            loading="eager"
          >

          <!-- Floating Clinical Callout 1 -->
          <div class="absolute top-6 right-6 bg-white/95 backdrop-blur-md px-4 py-3 rounded-2xl shadow-xl border border-slate-100 flex items-center gap-3 animate-pulse">
            <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center">
              <span class="material-symbols-outlined text-lg">science</span>
            </div>
            <div>
              <p class="text-[10px] uppercase font-extrabold text-slate-400 tracking-wider">Active Grade</p>
              <p class="text-xs font-bold text-slate-900">Triple Molecular Acid</p>
            </div>
          </div>

          <!-- Floating Clinical Callout 2 -->
          <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-4 rounded-2xl shadow-xl border border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-xl">biotech</span>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900">CeraRepair™ Cellular Complex</p>
                <p class="text-[11px] text-slate-500">Physician Approved Formula</p>
              </div>
            </div>
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">Rx Clean</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Hero Badge",
      "default": "Dermatologist-Formulated Medical Skincare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure Clinical Actives. Proven Molecular Barrier Repair."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Precision dermatology formulations engineered with medical-grade biomimetic ceramides, bio-fermented niacinamide, and micro-molecular hydration."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Shop Formulations"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Build 3-Step Routine"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA Link"
    },
    {
      "type": "text",
      "id": "hero_image",
      "label": "Hero Image URL",
      "default": "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=800&q=85"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
