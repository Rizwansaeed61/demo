<section class="py-16 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-clinical bg-blue-50 text-primary border border-blue-200/50 mb-3">Targeted Protocols</span>
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Formulated for Your Exact Skin Concern</h2>
      <p class="text-sm text-slate-500 mt-2">Dermatologist-curated clinical systems addressing the root cellular causes of dermal distress.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      
      <a href="/collections/acne-blemish" class="group bg-white p-5 rounded-2xl border border-slate-200/70 hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-2xl">sanitizer</span>
        </div>
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">Acne & Congestion</h3>
        <p class="text-[11px] text-slate-400 mt-1">Salicylic + Zinc PCA</p>
      </a>

      <a href="/collections/barrier-repair" class="group bg-white p-5 rounded-2xl border border-slate-200/70 hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-2xl">shield_with_heart</span>
        </div>
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">Barrier Breakdown</h3>
        <p class="text-[11px] text-slate-400 mt-1">Bio-Ceramide 3:1:1</p>
      </a>

      <a href="/collections/hyperpigmentation" class="group bg-white p-5 rounded-2xl border border-slate-200/70 hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-violet-50 text-violet-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-2xl">flare</span>
        </div>
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">Dark Spots & Tone</h3>
        <p class="text-[11px] text-slate-400 mt-1">Tranexamic 5%</p>
      </a>

      <a href="/collections/anti-aging" class="group bg-white p-5 rounded-2xl border border-slate-200/70 hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-sky-50 text-sky-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-2xl">hourglass_top</span>
        </div>
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">Cellular Aging</h3>
        <p class="text-[11px] text-slate-400 mt-1">Granactive Retinoid</p>
      </a>

      <a href="/collections/sensitive-skin" class="group bg-white p-5 rounded-2xl border border-slate-200/70 hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-2xl">spa</span>
        </div>
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors">Extreme Sensitivity</h3>
        <p class="text-[11px] text-slate-400 mt-1">Centella & Ectoin</p>
      </a>

    </div>
  </div>
</section>

