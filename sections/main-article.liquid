<article class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <span class="badge-clinical bg-primary/10 text-primary mb-3">Clinical Whitepaper</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">{{ article.title }}</h1>
      <span class="text-xs text-slate-400">{{ article.published_at | date: '%B %d, %Y' }} • {{ article.author }}</span>
    </div>

    {%- if article.image -%}
      <div class="aspect-video rounded-3xl overflow-hidden mb-10 shadow-lg">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" class="w-full h-full object-cover">
      </div>
    {%- endif -%}

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-base">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
