<section class="py-16 bg-surface min-h-[60vh]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Your Clinical Regimen</h1>
        <p class="text-xs text-slate-500 mt-1">Review active formulations prior to final dispensing.</p>
      </div>
      <a href="/collections/all" class="text-xs font-bold text-primary hover:underline">
        &larr; Continue Formulations
      </a>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Cart Items (8 cols) -->
        <div class="lg:col-span-8 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-6">
          {%- for item in cart.items -%}
            <div class="flex items-center gap-4 py-4 border-b border-slate-100 last:border-none">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-20 h-20 rounded-2xl object-cover bg-slate-50 flex-shrink-0">
              {%- endif -%}

              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-slate-900 text-base truncate">{{ item.product.title }}</h3>
                <p class="text-xs text-slate-500 mb-2">{{ item.variant.title }}</p>
                <div class="flex items-center gap-4">
                  <div class="qty-stepper scale-90 -ml-1">
                    <button type="button" class="qty-btn" onclick="ShopifyCart.updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                    <input type="text" class="qty-input" value="{{ item.quantity }}" readonly>
                    <button type="button" class="qty-btn" onclick="ShopifyCart.updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="text-xs text-rose-600 hover:underline">Remove</a>
                </div>
              </div>

              <div class="text-right">
                <span class="font-bold text-slate-900 text-base block">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Order Summary (4 cols) -->
        <div class="lg:col-span-4 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-4">
          <h3 class="text-base font-extrabold text-slate-900 pb-3 border-b border-slate-100">Order Summary</h3>
          
          <div class="flex justify-between text-sm text-slate-600">
            <span>Subtotal</span>
            <span class="font-extrabold text-slate-900">{{ cart.total_price | money }}</span>
          </div>

          <div class="flex justify-between text-xs text-slate-500">
            <span>Express Shipping</span>
            <span class="text-emerald-700 font-bold">{% if cart.total_price >= 7500 %}FREE{% else %}Calculated next{% endif %}</span>
          </div>

          <p class="text-[11px] text-slate-400 pt-2 border-t border-slate-100">
            Taxes and clinical dispensary fees calculated at checkout.
          </p>

          <button type="submit" name="checkout" class="btn-primary w-full py-3.5 text-base flex items-center justify-center gap-2 shadow-md">
            <span>Proceed to Checkout</span>
            <span class="material-symbols-outlined text-lg">lock</span>
          </button>
        </div>

      </form>
    {%- else -%}
      <div class="bg-white rounded-3xl p-12 text-center border border-slate-200/80 max-w-lg mx-auto">
        <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">shopping_bag</span>
        <h2 class="text-xl font-bold text-slate-900">Your clinical regimen is empty</h2>
        <p class="text-xs text-slate-500 mt-2 mb-6">Explore our targeted active treatments or take our clinical skin assessment.</p>
        <a href="/collections/all" class="btn-primary py-3 px-8">Browse Formulations</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
