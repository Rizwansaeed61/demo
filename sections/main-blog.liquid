<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-clinical bg-emerald-50 text-emerald-800 mb-2">Dermatology Science</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">{{ blog.title }}</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- for article in blog.articles -%}
        <article class="bg-surface rounded-2xl overflow-hidden border border-slate-200/70 hover:shadow-lg transition-all flex flex-col group">
          {%- if article.image -%}
            <div class="aspect-video overflow-hidden">
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform">
            </div>
          {%- endif -%}
          <div class="p-6 flex flex-col flex-1">
            <span class="text-xs text-slate-400 font-semibold mb-2">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <h2 class="text-base font-bold text-slate-900 group-hover:text-primary transition-colors">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>
            <p class="text-xs text-slate-500 mt-2 line-clamp-3">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Posts",
  "settings": []
}
{% endschema %}
