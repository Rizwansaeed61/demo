<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:bg-primary-dark transition-all">
            <span class="material-symbols-outlined text-2xl">medical_services</span>
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-slate-900 block leading-tight">
              Derma<span class="text-primary">Pure</span>
            </span>
            <span class="text-[9px] uppercase tracking-widest text-slate-400 font-bold block -mt-0.5">
              Clinical Dermatology
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-700">
        <a href="/collections/all" class="hover:text-primary transition-colors">Shop Formulations</a>
        <a href="/collections/serums" class="hover:text-primary transition-colors">Targeted Actives</a>
        <a href="/collections/barrier-support" class="hover:text-primary transition-colors">Barrier Care</a>
        <a href="/pages/routine-builder" class="text-emerald-700 font-bold hover:text-emerald-800 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-base">auto_fix_high</span>
          Routine Builder
        </a>
        <a href="/pages/clinical-trials" class="hover:text-primary transition-colors">Clinical Evidence</a>
      </nav>

      <!-- Utility Icons -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger -->
        <a href="/search" class="w-10 h-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-600 transition-colors" title="Search formulations">
          <span class="material-symbols-outlined text-xl">search</span>
        </a>

        <!-- Account -->
        <a href="/account" class="hidden sm:flex w-10 h-10 rounded-full hover:bg-slate-100 items-center justify-center text-slate-600 transition-colors" title="My Account">
          <span class="material-symbols-outlined text-xl">person</span>
        </a>

        <!-- Cart Trigger with Badge -->
        <button
          type="button"
          data-action="open-cart"
          class="relative flex items-center gap-2.5 bg-primary text-white px-4 py-2.5 rounded-full hover:bg-primary-dark shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-xl leading-none">shopping_bag</span>
          <span class="text-xs font-bold uppercase tracking-wider hidden sm:inline">Regimen</span>
          <span
            data-cart-count
            class="w-5 h-5 rounded-full bg-emerald-400 text-slate-950 text-[11px] font-extrabold flex items-center justify-center"
          >
            {{ cart.item_count | default: 0 }}
          </span>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
