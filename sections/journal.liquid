<section class="py-16 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
      <div>
        <span class="badge-clinical bg-primary/10 text-primary mb-2">Dermatology Science</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Clinical Research & Papers</h2>
        <p class="text-sm text-slate-500 mt-1">Peer-reviewed insights into cellular renewal, barrier science, and physiological skincare.</p>
      </div>
      <a href="/blogs/clinical-journal" class="mt-4 md:mt-0 text-sm font-bold text-primary hover:text-primary-dark flex items-center gap-1 group">
        <span>Read All Whitepapers</span>
        <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <article class="bg-surface rounded-2xl overflow-hidden border border-slate-200/70 hover:shadow-lg transition-all flex flex-col group">
        <div class="aspect-video bg-slate-100 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=600&q=80" alt="Laboratory research on ceramides" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[10px] font-bold px-2.5 py-1 rounded-full text-slate-800">Barrier Science</span>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <span class="text-xs text-slate-400 font-semibold mb-2">Oct 14, 2025 • 6 min read</span>
          <h3 class="text-base font-bold text-slate-900 leading-snug group-hover:text-primary transition-colors">
            Understanding TEWL: How Ceramide 3:1:1 Restores Compromised Lipids
          </h3>
          <p class="text-xs text-slate-500 mt-2 line-clamp-2">
            A comprehensive molecular breakdown of stratum corneum intercellular lipids and why isolated ceramides fail without fatty acids.
          </p>
          <div class="mt-auto pt-4 flex items-center text-xs font-bold text-primary">
            <span>Read Clinical Whitepaper</span>
            <span class="material-symbols-outlined text-sm ml-1">chevron_right</span>
          </div>
        </div>
      </article>

      <article class="bg-surface rounded-2xl overflow-hidden border border-slate-200/70 hover:shadow-lg transition-all flex flex-col group">
        <div class="aspect-video bg-slate-100 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1576086213369-97a306d36557?w=600&q=80" alt="Microscope analysis" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[10px] font-bold px-2.5 py-1 rounded-full text-slate-800">Pharmacology</span>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <span class="text-xs text-slate-400 font-semibold mb-2">Nov 02, 2025 • 8 min read</span>
          <h3 class="text-base font-bold text-slate-900 leading-snug group-hover:text-primary transition-colors">
            The Acid Mantle Dilemma: Why High pH Cleansers Destroy Skin Microbiome
          </h3>
          <p class="text-xs text-slate-500 mt-2 line-clamp-2">
            Clinical analysis on why conventional foaming soaps cause long-term skin barrier sensitization and reactive inflammation.
          </p>
          <div class="mt-auto pt-4 flex items-center text-xs font-bold text-primary">
            <span>Read Clinical Whitepaper</span>
            <span class="material-symbols-outlined text-sm ml-1">chevron_right</span>
          </div>
        </div>
      </article>

      <article class="bg-surface rounded-2xl overflow-hidden border border-slate-200/70 hover:shadow-lg transition-all flex flex-col group">
        <div class="aspect-video bg-slate-100 overflow-hidden relative">
          <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=600&q=80" alt="Cellular lab testing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[10px] font-bold px-2.5 py-1 rounded-full text-slate-800">Photobiology</span>
        </div>
        <div class="p-6 flex flex-col flex-1">
          <span class="text-xs text-slate-400 font-semibold mb-2">Nov 28, 2025 • 5 min read</span>
          <h3 class="text-base font-bold text-slate-900 leading-snug group-hover:text-primary transition-colors">
            Non-Nano Zinc vs Chemical Filters: Long-Term Photostability Comparison
          </h3>
          <p class="text-xs text-slate-500 mt-2 line-clamp-2">
            Reviewing spectral absorbance curves and the role of physical reflection in post-procedure skin healing.
          </p>
          <div class="mt-auto pt-4 flex items-center text-xs font-bold text-primary">
            <span>Read Clinical Whitepaper</span>
            <span class="material-symbols-outlined text-sm ml-1">chevron_right</span>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

