<div class="bg-slate-900 text-white text-[11px] font-semibold tracking-wider uppercase py-2 px-4 border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex items-center justify-between text-center sm:text-left">
    <div class="flex items-center gap-2 mx-auto sm:mx-0">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{{ section.settings.text | default: settings.announcement_text }}</span>
    </div>
    <div class="hidden sm:flex items-center gap-4 text-slate-300">
      <span class="flex items-center gap-1">
        <span class="material-symbols-outlined text-sm text-emerald-400">verified</span>
        Clinically Tested
      </span>
      <span>•</span>
      <a href="/pages/routine-builder" class="hover:text-white transition-colors underline decoration-emerald-400 underline-offset-4">
        Build 3-Step Routine (Save 15%)
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "COMPLIMENTARY CLINICAL DERMATOLOGY SHIPPING ON ORDERS OVER $75 • 100% RECYCLABLE PACKAGING"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
