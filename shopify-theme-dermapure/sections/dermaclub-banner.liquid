<section class="py-16 bg-primary text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-emerald-400 text-slate-950 text-xs font-bold uppercase tracking-wider mb-4">
        Exclusive Physician Access
      </span>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4">
        Join the DermaPure Clinical Society
      </h2>
      <p class="text-slate-200 text-sm sm:text-base leading-relaxed mb-8 max-w-xl mx-auto">
        Receive 15% off your initial clinical formulation, priority access to new active molecule drops, and quarterly medical dermatology research briefings.
      </p>

      {% form 'customer', class: 'max-w-md mx-auto flex flex-col sm:flex-row gap-3' %}
        <input type="hidden" name="contact[tags]" value="newsletter,dermaclub">
        <input
          type="email"
          name="contact[email]"
          placeholder="Enter your email address"
          required
          class="flex-1 px-5 py-3.5 rounded-full bg-white/10 border border-white/20 text-white placeholder:text-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-sm"
        >
        <button
          type="submit"
          class="bg-emerald-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-full hover:bg-emerald-300 transition-all text-sm flex-shrink-0 shadow-lg"
        >
          Subscribe
        </button>
      {% endform %}

      <p class="text-[11px] text-slate-300 mt-4">
        Strict clinical confidentiality. Zero spam. Unsubscribe anytime.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DermaClub Banner",
  "settings": [],
  "presets": [
    {
      "name": "DermaClub Banner"
    }
  ]
}
{% endschema %}
